@model IReadOnlyList<CountryResult>
<h1>🌎 Explorador de países</h1><p>Datos de REST Countries</p><form method="get"><label>Buscar país <input name="name" value="@ViewBag.Name" maxlength="80" required /></label><button>Buscar</button></form>@if(ViewBag.Error != null){<p class="error">@ViewBag.Error</p>}@if(Model != null){<div class="grid">@foreach(var c in Model){<article class="card">@if(!string.IsNullOrWhiteSpace(c.Flag)){<img class="flag" src="@c.Flag" alt="Bandera de @c.Name"/>}<h2>@c.Name</h2><p>Capital: @c.Capital</p><p>Región: @c.Region</p><p>Población: @c.Population.ToString("N0")</p></article>}</div>}