@model IReadOnlyList<CountryResult>
@{var options=ViewBag.Options as IReadOnlyList<string> ?? Array.Empty<string>();string selected=ViewBag.Name??"Panama";}
<h1>🌎 Explorador de países</h1><p>Selecciona un país para ver sus datos.</p>
<form method="get"><label>País <select name="name" required>@foreach(var name in options){if(name==selected){<option value="@name" selected>@name</option>}else{<option value="@name">@name</option>}}</select></label><button>Consultar</button></form>
@if(ViewBag.Error!=null){<p class="error">@ViewBag.Error</p>}
@if(Model!=null){<div class="grid">@foreach(var c in Model){<article class="card">@if(!string.IsNullOrWhiteSpace(c.Flag)){<img class="flag" src="@c.Flag" alt="Bandera de @c.Name"/>}<h2>@c.Name</h2><p>Capital: @c.Capital</p><p>Región: @c.Region</p><p>Población: @c.Population.ToString("N0")</p></article>}</div>}