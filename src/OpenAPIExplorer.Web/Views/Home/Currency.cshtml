@model CurrencyResult
<h1>💱 Conversor de monedas</h1><p>Datos de Frankfurter v2</p><form method="get"><label>Desde <input name="from" value="@ViewBag.From" maxlength="3" required /></label><label>Hasta <input name="to" value="@ViewBag.To" maxlength="3" required /></label><label>Monto <input name="amount" type="number" min="0.01" step="0.01" value="@ViewBag.Amount" required /></label><button>Convertir</button></form>@if(ViewBag.Error != null){<p class="error">@ViewBag.Error</p>}@if(Model != null){<article class="result"><h2>@Model.Amount @Model.From</h2><div class="metric">@Model.Converted @Model.To</div><p>Tasa: @Model.Rate · Fecha: @Model.Date</p></article>}